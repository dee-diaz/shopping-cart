{
  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "outDir": "./dist/",
    "sourceMap": true,
    "strictNullChecks": true,

    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "strict": true,

    "resolveJsonModule": true,
    "isolatedModules": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": ["src"]
}
